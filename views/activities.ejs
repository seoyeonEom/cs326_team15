<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="htmx-config" content='{"timeout": 5000}'>
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <script
      src="https://unpkg.com/htmx.org@2.0.11/dist/htmx.min.js"
      integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
      crossorigin="anonymous"
    ></script>
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-slate-900">
    <%- include('partials/header') %>

    <main class="mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 sm:py-10">
      <section aria-labelledby="logging-title">
        <h2 id="logging-title" class="mb-4 text-xl font-bold tracking-tight">
          Transportation Activity Logging
        </h2>

        <form
          id="activity-form"
          class="grid grid-cols-1 gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2 sm:p-6"
        >
          <label class="flex min-w-0 flex-col gap-2 text-sm font-medium text-slate-700">
            Date
            <input
              type="date"
              name="date"
              required
              class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-emerald-600"
            >
          </label>

          <label class="flex min-w-0 flex-col gap-2 text-sm font-medium text-slate-700">
            Transportation method
            <select
              name="method"
              required
              class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-emerald-600"
            >
              <option value="">Select a method</option>
              <option value="walking">Walking</option>
              <option value="cycling">Cycling</option>
              <option value="bus">Bus</option>
              <option value="car">Car</option>
            </select>
          </label>

          <label class="flex min-w-0 flex-col gap-2 text-sm font-medium text-slate-700">
            Distance
            <input
              type="number"
              name="distance"
              min="0.001"
              step="any"
              required
              class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-emerald-600"
            >
          </label>

          <label class="flex min-w-0 flex-col gap-2 text-sm font-medium text-slate-700">
            Unit
            <select
              name="unit"
              required
              class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-emerald-600"
            >
              <option value="km">km</option>
              <option value="mi">mi</option>
            </select>
          </label>

          <button
            type="submit"
            class="min-h-11 w-full cursor-pointer rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 sm:col-span-2 sm:w-auto sm:justify-self-start"
          >
            Save activity
          </button>
        </form>
      </section>

      <p
        id="message"
        class="min-h-6 break-words text-sm font-medium text-slate-700"
        role="status"
        aria-live="polite"
      ></p>

      <section
        id="emissions-breakdown"
        aria-labelledby="breakdown-title"
        class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
      >
        <h2 id="breakdown-title" class="text-xl font-bold tracking-tight">
          Transportation Emissions Breakdown
        </h2>

        <div class="flex flex-col gap-2 sm:max-w-sm">
          <label for="method-filter" class="text-sm font-medium text-slate-700">
            Filter by transportation method
          </label>

          <select
            id="method-filter"
            name="method"
            class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-emerald-600"
            hx-get="/activities/breakdown"
            hx-trigger="change, activities-changed from:body"
            hx-target="#breakdown-results"
            hx-swap="innerHTML"
          >
            <option value="">All transportation</option>
            <option value="walking">Walking</option>
            <option value="cycling">Cycling</option>
            <option value="bus">Bus</option>
            <option value="car">Car</option>
          </select>
        </div>

        <div id="breakdown-results">
          <%- include('partials/breakdown', { breakdown }) %>
        </div>
      </section>
    </main>

    <script src="/app.js" defer></script>
  </body>
</html>
