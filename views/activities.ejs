<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="htmx-config" content='{"timeout": 5000}'>
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/htmx.org@2.0.11/dist/htmx.min.js"
            integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
            crossorigin="anonymous"></script>
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <h2>Transportation Activity Logging</h2>
      <form id="activity-form">
        <label>Date <input type="date" name="date" required></label>
        <label>Transportation method
          <select name="method" required>
            <option value="">Select a method</option>
            <option value="walking">Walking</option>
            <option value="cycling">Cycling</option>
            <option value="bus">Bus</option>
            <option value="car">Car</option>
          </select>
        </label>
        <label>Distance <input type="number" name="distance" min="0.001" step="any" required></label>
        <label>Unit
          <select name="unit" required>
            <option value="km">km</option>
            <option value="mi">mi</option>
          </select>
        </label>
        <button type="submit">Save activity</button>
      </form>

      <p id="message" role="status" aria-live="polite"></p>

      <section id="emissions-breakdown">
        <h2>Transportation Emissions Breakdown</h2>

        <label for="method-filter">Filter by transportation method:</label>
        <select id="method-filter" name="method"
                hx-get="/activities/breakdown"
                hx-trigger="change, activities-changed from:body"
                hx-target="#breakdown-results"
                hx-swap="innerHTML">
          <option value="">All transportation</option>
          <option value="walking">Walking</option>
          <option value="cycling">Cycling</option>
          <option value="bus">Bus</option>
          <option value="car">Car</option>
        </select>

        <div id="breakdown-results">
          <%- include('partials/breakdown', { breakdown }) %>
        </div>
      </section>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
