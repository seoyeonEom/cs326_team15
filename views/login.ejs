
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Carbon Footprint Tracker</title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-slate-900">
    <%- include('partials/header') %>

    <main class="mx-auto max-w-md px-4 py-12">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="mb-2 text-2xl font-bold">Welcome back</h2>
        <p class="mb-6 text-sm text-slate-600">
          Log in to continue tracking your carbon footprint.
        </p>

        <% if (error) { %>
          <p role="alert" class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">
            <%= error %>
          </p>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
          <div>
            <label for="email" class="mb-1 block text-sm font-medium">
              Email address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              value="<%= email %>"
              autocomplete="email"
              required
              class="form-input w-full"
            >
          </div>

          <div>
            <label for="password" class="mb-1 block text-sm font-medium">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="form-input w-full"
            >
          </div>

          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="rememberMe" value="true">
            Remember me
          </label>

          <button type="submit" class="submit-button w-full">
            Log in
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-600">
          Don't have an account?
          <a href="/signup" class="font-semibold text-emerald-700 underline">
            Sign up
          </a>
        </p>
      </section>
    </main>
  </body>
</html>
