<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Carbon Footprint Tracker</title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-slate-900">
    <%- include('partials/header') %>

    <main class="mx-auto max-w-5xl px-4 py-12">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-2xl font-bold">
          Welcome to our Carbon Footprint Tracker!
        </h2>

        <p class="mb-3 text-slate-700">
          Track your daily carbon footprint and monitor your environmental impact.
        </p>

        <p class="text-slate-700">
          Record transportation activities and set goals to build more sustainable habits.
        </p>
      </section>
    </main>
  </body>
</html>
