<div class="breakdown-outer-div">
  <div class="total-emissions-div">
    <p class="total-emissions-p">
      Total CO2 emissions
    </p>

    <strong
      id="total-emissions"
      class="total-emissions-strong"
    >
      <%= breakdown.totalEmissions %> kg CO₂
    </strong>
  </div>

  <div class="num-activities-div">
    <p class="num-activities-p">
      Number of activities
    </p>

    <strong
      id="activity-count"
      class="num-activities-strong"
    >
      <%= breakdown.activityCount %>
    </strong>
  </div>
</div>

<h3 class="saved-activities-h3">
  Saved Activities
</h3>

<% if (breakdown.activities.length === 0) { %>
  <p class="no-activities-p">
    No activities to show.
  </p>
<% } else { %>
  <ul id="activities" class="breakdown-ul">
    <% breakdown.activities.forEach((activity) => { %>
      <li class="breakdown-li">
        <span class="breakdown-span">
          <strong class="">
            <%= activity.date %>
          </strong>
          — <%= activity.method %>,
          <%= activity.distance %> <%= activity.unit %>
          — <%= activity.emissions %> kg CO₂
        </span>

        <button
          type="button"
          class="breakdown-delete-button"
          hx-delete="/activities/<%= activity.id %>"
          hx-target="closest li"
          hx-swap="outerHTML"
          hx-confirm="Delete this activity?"
          aria-label="Delete the <%= activity.method %> activity on <%= activity.date %>"
        >
          Delete
        </button>
      </li>
    <% }); %>
  </ul>
<% } %>
