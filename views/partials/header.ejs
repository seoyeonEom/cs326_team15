<header class="header">
  <div class="header-div">
    <h1 class="header-title">Carbon Footprint Tracker</h1>

    <nav aria-label="Main navigation" class="header-nav">
      <a href="/" class="header-nav-link"> Home </a>

      <a href="/dashboard" class="header-nav-link"> Dashboard </a>

      <a href="/activities" class="header-nav-link"> Activities </a>

      <a href="/goals" class="header-nav-link"> Goals </a>
      <% if (typeof user !== "undefined" && user) { %>
        <form action="/logout" method="POST">
          <button type="submit" class="header-nav-link">
            Log out
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="header-nav-link">Log in</a>
        <a href="/signup" class="header-nav-link">Sign up</a>
      <% } %>
    </nav>
  </div>
</header>
